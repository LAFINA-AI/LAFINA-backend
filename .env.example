# ==============================================================================
# LAFINA Backend — Vercel + Neon Postgres Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file containing real API keys and secrets!
# ==============================================================================

# Vercel / Neon Production Deployment
ENVIRONMENT=production
API_BASE_URL=https://your-lafina-backend.vercel.app

# Neon Postgres Connection Strings (automatically injected when linking Neon in Vercel,
# or pulled locally with `neon env pull` / `vercel env pull`):
# - DATABASE_URL: Pooled connection (`-pooler` hostname) used by the FastAPI app
# - DATABASE_URL_UNPOOLED: Direct connection (no `-pooler`) used by Alembic migrations
#   and the Render-to-Neon migration script.
# Standard `postgresql://...` or `postgresql+asyncpg://...` URLs both work automatically.
DATABASE_URL=postgresql://NEON_USER:NEON_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://NEON_USER:NEON_PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Optional: Legacy Render External Database URL (used only once by
# `python -m scripts.migrate_render_to_neon` to copy personal data to Neon)
# RENDER_DATABASE_URL=postgresql://RENDER_USER:RENDER_PASSWORD@RENDER_EXTERNAL_HOST.render.com/RENDER_DB_NAME?sslmode=require

# Bootstrap Admin Account
ADMIN_EMAIL=admin@lafina.app
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_15_CHARACTERS

# Local development alternatives:
# ENVIRONMENT=development
# API_BASE_URL=http://localhost:8000
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lafina

# JWT RS256 Authentication Keys (Auto-generated in dev if omitted; set fixed keys on Vercel!)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=lafina-auth
JWT_AUDIENCE=lafina-app
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloud LLM & AI Services (Online Features — Student Pro / Admin)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Cloud Voice & Speech Services (Online TTS Preview — Student Pro)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Aoede

# Student Handbook RAG (online assistant quotes the USTP Student Handbook).
# Pinecone stores the passages and embeds them with its hosted model
# (llama-text-embed-v2, 768 dimensions), so this key and index are all it needs.
# Index the handbook once, from the repository root:
#   python -m scripts.ingest_handbook --pdf path/to/ustp_handbook.pdf --replace
# Turn it on or off at runtime in the admin panel: Feature Flags > handbook_rag.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional overrides:
# HANDBOOK_NAMESPACE=ustp-handbook-2023
# HANDBOOK_MIN_SCORE=0.30

# ElevenLabs online TTS (server only; replaces the Gemini TTS route).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=BtcCEANLn920ZIoN9grW
ELEVENLABS_MODEL_ID=eleven_v4
# Voice-mode conversation (requests with latency "low"); about 3x faster.
ELEVENLABS_FAST_MODEL_ID=eleven_v4_turbo
ELEVENLABS_MAX_CHARACTERS_PER_PROCESS=20000

# Live voice conversation (ElevenAgents + this server as the agent's custom LLM).
# The ElevenLabs key above needs the ElevenAgents (Conversational AI) read/write
# permission. Generate the shared secret yourself (for example 48 random hex
# characters); scripts/provision_voice_agent.py --apply uploads it to the
# ElevenLabs secret store and creates the private agent, whose id goes below.
# Leave either empty to keep the feature off ("not set up" in the app).
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_LLM_SECRET=
# Optional limits (defaults shown):
# VOICE_CONVERSATION_MAX_SECONDS=300
# VOICE_CONVERSATION_START_GRACE_SECONDS=120
# VOICE_CONVERSATION_MAX_TURNS=30
# VOICE_CONVERSATION_SESSIONS_PER_DAY=6
# VOICE_CONVERSATION_TURNS_PER_MIN=12
# VOICE_CONVERSATION_TURNS_PER_DAY=150
# VOICE_CONVERSATION_MAX_CONTEXT_MESSAGES=12
# VOICE_CONVERSATION_MAX_CONTEXT_CHARS=6000
# VOICE_CONVERSATION_MAX_STUDENT_CONTEXT_CHARS=12000
# VOICE_CONVERSATION_MAX_REPLY_TOKENS=300
